# Copy to .env and fill in. scripts/*.sh load it automatically; .env is git-ignored.

# Weights & Biases (training logs). WANDB_MODE: online | offline | disabled
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=looped_udlm
WANDB_MODE=online

# Hugging Face token: needed only while the data / checkpoint repos are private.
HF_TOKEN=

# Where the packed datasets live (default: ./data) and where runs are written.
LOOPED_UDLM_DATA=
OUTPUT_ROOT=

# GPUs to use (default: all visible). Global batch stays 512 for any count.
CUDA_VISIBLE_DEVICES=
